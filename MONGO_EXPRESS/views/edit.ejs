<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Your Chat</title>
  </head>
  <body>
    <h3>Edit Your Chat</h3>
    <p>
      This Chat was sent from<%= chat.from %> to <%chat.to %></p>
    <form
      method="POST"
      action="/chats/<%= chat._id %>?_method=PUT">
      <textarea name="msg" rows="5" cols="30"><%= chat.msg %></textarea>
      <br /><br />
      <button>Edit</button>
    </form>
  </body>
</html> 